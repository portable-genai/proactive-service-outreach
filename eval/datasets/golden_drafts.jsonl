# Golden candidate drafts (obviously fictional). Each line is one thing a drafter might return
# and the INDEPENDENT label for whether the validator must accept it. The candidates were
# written by hand against the rules in domain/drafting.py, not produced by any adapter in this
# repo: a metric that scored a drafter's output against facts the same drafter chose would be a
# tautology, which is the exact failure the eval discipline exists to prevent.
#
# Fields: template_id, locale, channel, facts, candidate (the RAW string a port returned),
# expected_accepted, why.
{"id": "d1", "template_id": "failed_payment_retry", "locale": "en-SG", "channel": "chat", "facts": {"card_suffix": "4242", "retry_on": "2026-08-11"}, "candidate": "{\"body\": \"A payment on the card ending 4242 did not go through. We will try again on 2026-08-11. You can update the card in the app.\"}", "expected_accepted": true, "why": "every figure is in the facts and both required facts are quoted"}
{"id": "d2", "template_id": "failed_payment_retry", "locale": "en-SG", "channel": "chat", "facts": {"card_suffix": "4242", "retry_on": "2026-08-11"}, "candidate": "{\"body\": \"Your card ending 4242 was declined for 250 dollars. We will retry on 2026-08-11.\"}", "expected_accepted": false, "why": "the amount 250 is not in the facts: the classic invented figure"}
{"id": "d3", "template_id": "delivery_exception_reschedule", "locale": "en-AU", "channel": "chat", "facts": {"tracking_ref": "TRK-77120", "next_attempt_on": "2026-08-12"}, "candidate": "{\"body\": \"Delivery TRK-77120 could not be completed. The next attempt is 2026-08-12, and you can reschedule in the app.\"}", "expected_accepted": true, "why": "grounded and complete"}
{"id": "d4", "template_id": "delivery_exception_reschedule", "locale": "en-AU", "channel": "chat", "facts": {"tracking_ref": "TRK-77120", "next_attempt_on": "2026-08-12"}, "candidate": "{\"body\": \"Your delivery could not be completed. We will try again soon.\"}", "expected_accepted": false, "why": "neither required fact is quoted: a notification that says nothing actionable"}
{"id": "d5", "template_id": "outage_status", "locale": "en-AU", "channel": "chat", "facts": {"outage_ref": "OUT-3312", "affected_service": "Card payments"}, "candidate": "{\"body\": \"Card payments is currently disrupted (reference OUT-3312). Compensation will be applied to your account.\"}", "expected_accepted": false, "why": "a banned phrase: this service does not promise compensation"}
{"id": "d6", "template_id": "fraud_hold_verify", "locale": "en-SG", "channel": "voice", "facts": {"hold_ref": "FH-4471", "card_suffix": "3310"}, "candidate": "{\"body\": \"A hold was placed on the card ending 3310 (reference FH-4471). Please verify your card number to release it.\"}", "expected_accepted": false, "why": "a credential-phishing sentence a bank must never send"}
{"id": "d7", "template_id": "expiring_card_renew", "locale": "ja-JP", "channel": "chat", "facts": {"card_suffix": "8871", "expires_on": "2026-09-30"}, "candidate": "The card ending 8871 expires on 2026-09-30.", "expected_accepted": false, "why": "not JSON: the output has no schema, so it has no meaning"}
{"id": "d8", "template_id": "expiring_card_renew", "locale": "ja-JP", "channel": "chat", "facts": {"card_suffix": "8871", "expires_on": "2026-09-30"}, "candidate": "{\"note\": \"looks fine to me\"}", "expected_accepted": false, "why": "JSON, but no body: an envelope with nothing in it"}
{"id": "d9", "template_id": "failed_payment_retry", "locale": "en-SG", "channel": "chat", "facts": {"card_suffix": "4242", "retry_on": "2026-08-11"}, "candidate": "{\"body\": \"A payment on the card ending 4242 did not go through. We will retry on 2026-08-11. Please call the branch and quote NRIC S1234567D.\"}", "expected_accepted": false, "why": "the model put a national identifier in a message body"}
{"id": "d10", "template_id": "expiring_card_renew", "locale": "en-SG", "channel": "chat", "facts": {"card_suffix": "8871", "expires_on": "2026-09-30"}, "candidate": "{\"body\": \"The card ending 8871 expires on 2026-09-30. Renewing it in the app keeps your scheduled payments running, and renewal is guaranteed to complete instantly with no further checks of any kind whatsoever for every customer on every product line in every market we serve today.\"}", "expected_accepted": false, "why": "over the configured length AND carries a banned promise"}
